#!/bin/bash

echo "Please choose an option:"
echo "[1] Run benchmarks"
echo "[2] Generate normal distributions"
echo "[3] Generate LaTeX report"
echo

read -rp "Option: " user_input

if [ "$user_input" == "1" ]; then
  python3 commands/subcommand_run_benchmarks.py
elif [ "$user_input" == "2" ]; then
  python3 commands/subcommand_plot_normal_distributions.py
elif [ "$user_input" == "3" ]; then
  python3 commands/subcommand_generate_latex.py
else
  echo "Invalid input. Enter an option between 1 and 3. Exiting with error."
  exit 1
fi
